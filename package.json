{
  "name": "discover-japan-feed",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/jetstream.ts",
    "serve": "tsx --env-file=.env src/server.ts",
    "publish": "tsx --env-file=.env src/publish.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx --env-file=.env src/db/reset.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.18.18",
    "drizzle-orm": "^0.38.0",
    "express": "^5.2.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
